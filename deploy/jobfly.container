[Unit]
Description=Jobfly connectome-powered job habitat
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/jobfly:latest
ContainerName=jobfly
PublishPort=127.0.0.1:8788:8787
Volume=/mnt/donto-data/donto-resources/research/jobfly-runtime/brain:/brain:ro
Volume=/mnt/donto-data/donto-resources/research/jobfly-runtime/public-state:/state:rw
Environment=JOBFLY_HOST=fly.jsonresume.org
Environment=NUMBA_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=FORWARDED_ALLOW_IPS=*
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Tmpfs=/tmp:rw,size=128m

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
MemoryMax=3G
CPUQuota=200%
IOWeight=20

[Install]
WantedBy=multi-user.target
