# Resume document conversion: set one of these (JSON upload needs neither).
OPENROUTER_API_KEY=
JOBFLY_CONVERSION_KEY_FILE=
JOBFLY_CONVERSION_MODEL=openrouter/free
# Optional job interpretation, separate from document conversion.
OPENAI_API_KEY=
JOBFLY_LLM_MODEL=gpt-4.1-mini
# Store model assets and personal sessions outside the repository.
FLY_DATA=/mnt/donto-data/donto-resources/research/jobfly-runtime/brain
JOBFLY_STATE=/mnt/donto-data/donto-resources/research/jobfly-runtime/state
NUMBA_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
